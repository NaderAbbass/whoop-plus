{
  "expo": {
    "name": "WHOOP+",
    "slug": "whoop-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naderabbas.whoopplus",
      "deploymentTarget": "15.0",
      "backgroundColor": "#000000",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "WHOOP+ needs Bluetooth to connect to your WHOOP band and collect heart rate data continuously.",
        "NSBluetoothPeripheralUsageDescription": "WHOOP+ needs Bluetooth to connect to your WHOOP band.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "processing",
          "fetch"
        ]
      }
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "WHOOP+ needs Bluetooth to connect to your WHOOP band and collect heart rate data continuously."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ]
    ]
  }
}
